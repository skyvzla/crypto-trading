# Trading Platform 配置示例

# Compose 服务名只在容器网络内解析，宿主机不需要安装数据库或 Redis
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=trading_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Binance Testnet（默认）
BINANCE_API_KEY=testnet_key
BINANCE_API_SECRET=testnet_secret
BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_WS_BASE_URL=wss://stream.binancefuture.com
BINANCE_TESTNET=true

# 正式网只在 Phase 6 人工批准后配置；不能与 testnet 密钥混用
# BINANCE_BASE_URL=https://fapi.binance.com
# BINANCE_WS_BASE_URL=wss://fstream.binance.com
# BINANCE_TESTNET=false

# 行情层
MARKET_HOST=0.0.0.0
MARKET_PORT=8000
MARKET_DATA_DIR=data/market

# 账本层
LEDGER_HOST=0.0.0.0
LEDGER_PORT=8001

# 策略配置
STRATEGY_ACCOUNT_ID=account_a
STRATEGY_MARKET_API_URL=http://market:8000
STRATEGY_RISK_MAX_POSITION_VALUE_USDT=10000.0
STRATEGY_RISK_MAX_SYMBOLS=10

# Spike testnet 进程（docker compose --profile spike up）
SPIKE_MODE=testnet
SPIKE_EXIT_POLICY=candidate-v1
SPIKE_ACCOUNT_ID=spike_testnet
SPIKE_SYMBOLS=AKEUSDT
SPIKE_TOTAL_NOTIONAL=20
SPIKE_WAL_PATH=data/wal/spike_short.jsonl
SPIKE_DEDICATED_STRATEGY_ACCOUNT=true
SPIKE_POLL_INTERVAL_SECONDS=5
SPIKE_MAX_POLL_ATTEMPTS=12

# 回测配置
BACKTEST_DATA_DIR=data/market
BACKTEST_OUTPUT_DIR=reports
BACKTEST_MAKER_FEE_RATE=0.0002
BACKTEST_TAKER_FEE_RATE=0.0004
